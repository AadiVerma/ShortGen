# Copy to .env (git-ignored) to override configuration without editing YAML.
# Any key from configs/default.yaml works: SHORTGEN__<SECTION>__<KEY>=value
# Real environment variables take precedence over this file.
# No secrets are needed by default: nothing in the default pipeline is paid or hosted.

# SHORTGEN__PROVIDERS__PLANNER=ollama
# SHORTGEN__PROVIDERS__VIDEO=wan
# SHORTGEN__PROJECT__ASPECT=16:9
# SHORTGEN__SUBTITLES__ENABLED=false
# SHORTGEN__PROVIDERS__IMAGE=folder        # use your own pictures from <project>/art/
# SHORTGEN__RENDER__FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# SHORTGEN__RUNTIME__LOG_FORMAT=json

# Standard Hugging Face settings also apply to model downloads, e.g.:
# HF_HOME=/path/with/space/for/models

# OPTIONAL, PAID: only for the hosted Higgsfield adapters (docs/hosted.md).
# Despite the prefix this is a Higgsfield key, not a Hugging Face one.
# HF_KEY=your-key:your-secret
